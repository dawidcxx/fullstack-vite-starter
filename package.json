{
  "name": "the_application_name",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run build:common && pnpm run dev:backend & pnpm run dev:web & pnpm run dev:common",
    "typecheck": "pnpm -r typecheck",
    "dev:backend": "pnpm --filter @the_application_name/backend dev",
    "dev:web": "pnpm --filter @the_application_name/web dev",
    "dev:common": "pnpm --filter @the_application_name/common dev",
    "build:backend": "pnpm --filter @the_application_name/backend build",
    "build:web": "pnpm --filter @the_application_name/web build",
    "build:common": "pnpm --filter @the_application_name/common build",
    "test": "pnpm -r test"
  },
  "packageManager": "pnpm@11.10.0"
}