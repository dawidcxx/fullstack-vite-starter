    "@the_application_name/common": "workspace:*",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.4",
    "postgres": "^3.4.5",
    "serialize-error": "^13.0.1",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
