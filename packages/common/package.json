{
  "name": "@the_application_name/common",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node build.mjs",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "dev": "tsc --emitDeclarationOnly --watch & esbuild ./src/index.ts --bundle --platform=browser --outdir=./dist --external:valibot --format=esm --watch",
    "test": "tsc --noEmit && node --import tsx/esm --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0"
  }
}