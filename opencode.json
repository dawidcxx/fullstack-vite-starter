{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "port": 4096,
  },
  "lsp": true,
  "mcp": {
    "@upstash/context7-mcp@latest": {
      "type": "local",
      "command": [
        "pnpx",
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["pnpx", "-y", "chrome-devtools-mcp@latest", "--autoConnect", "--no-usage-statistics"]
    }
  }
}